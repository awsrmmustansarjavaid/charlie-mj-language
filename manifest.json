{
  "manifest_version": 3,
  "name": "Charlie MJ Language",
  "short_name": "Charlie MJ",
  "version": "2.0.0",
  "description": "Multilingual YouTube language learning with transcript, dual transcript and YT Transcript Pro features, learning tools, language intelligence and local-first services.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "activeTab",
    "scripting",
    "commands",
    "tabs",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.googlevideo.com/*",
    "https://*.wiktionary.org/*",
    "https://*.youtube.com/*",
    "https://api-free.deepl.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://api.deepl.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.github.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translation.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Charlie MJ Language",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/content/youtube-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/transcript-pro/ytp-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/dual-transcript/dualTranscriptBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/lib/transcript-scroll.js",
        "src/transcript-pro/ytp-helpers.js",
        "src/transcript-pro/ytp-defaults.js",
        "src/transcript-pro/ytp-storage.js",
        "src/transcript-pro/ytp-theme.js",
        "src/transcript-pro/caption-parser.js",
        "src/transcript-pro/caption-extractor.js",
        "src/transcript-pro/language-manager.js",
        "src/transcript-pro/transcript-aligner.js",
        "src/transcript-pro/transcript-formatter.js",
        "src/transcript-pro/clipboard.js",
        "src/transcript-pro/txt-exporter.js",
        "src/transcript-pro/srt-exporter.js",
        "src/transcript-pro/vtt-exporter.js",
        "src/transcript-pro/csv-exporter.js",
        "src/transcript-pro/ytp-youtube-detector.js",
        "src/transcript-pro/ytp-content.js",
        "src/content/youtube.js",
        "src/content/subtitle-learning-controls.js"
      ],
      "css": [
        "src/transcript-pro/ytp-content.css",
        "src/content/youtube.css",
        "src/content/subtitle-learning-controls.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/lib/transcript-scroll.js",
        "src/dual-transcript/dualTranscript.js",
        "src/translation/dual-youtube-translation-service.js"
      ],
      "css": [
        "src/dual-transcript/dualTranscript.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/content/page-translator.js"
      ],
      "css": [
        "src/content/page-translator.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/options.html",
  "commands": {
    "toggle-focus-mode": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle Charlie MJ Focus Mode"
    },
    "save-current-vocabulary": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current subtitle as vocabulary"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "transcript-service.config.json",
        "src/additional/*",
        "data/*",
        "database/*"
      ],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}