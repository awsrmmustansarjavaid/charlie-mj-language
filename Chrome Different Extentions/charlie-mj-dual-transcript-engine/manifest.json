{
  "manifest_version": 3,
  "name": "Charlie MJ Dual Transcript Engine",
  "version": "1.0.0",
  "description": "Lightweight YouTube dual-transcript engine with native YouTube caption-track fetching, YouTube auto-translation, complete transcript caching, and precise timeline synchronization.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Charlie MJ Dual Transcript",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
